# ledger weather@1.0.0
# level:   L0
# profile: ui/l0
# model:   glm-5.2
#
# Reference card for Splash/docs/ui-profile-l0.md. Expresses everything
# app/app/src/app/plan/weather.rs lowers: CurrentConditions, Forecast,
# AirQualityField, SunMoon, Details.

# ── sources: queries the runtime executes; the view never calls them ──────────
source place       sys.geocode(name: state.city)
source now         sys.weather(lat: place.lat, lon: place.lon,
                               fields: [temp, feels, hi, lo, cond, humidity, wind,
                                        pressure, uv, precip])
source week        sys.weather(lat: place.lat, lon: place.lon, days: state.days,
                               fields: [dayname, hi, lo, cond],
                               aggregate: [min_lo, max_hi])
# `week` is a RECORD: `week.days` is the collection, `week.min_lo`/`max_hi` are
# the bounds every bar scales against. Those bounds were a hand-authored
# `wmin`/`wmax` in an earlier card and got invented by the model; here they come
# back with the data they describe.
source sun         sys.daylight(lat: place.lat, lon: place.lon)
source moon        sys.moonphase()
source scene       sys.photo(query: place.name)
source env.locale  sys.locale()

# ── state: shape only; the runtime holds the values ──────────────────────────
state city  { shape: text, initial: "" }              # empty ⇒ device location
state units { shape: enum[c, f], initial: env.locale.temp_unit }
state days  { shape: number, initial: 7 }

# ── events: total transitions, applied atomically ────────────────────────────
event toggle_units { units: cycle(.c, .f) }
event pick_city    { city: set($value) }

# ── copy: declared literals, all host-owned vocabulary ───────────────────────
copy feels      { class: vocabulary, en: "Feels like",   zh: "体感" }
copy humidity   { class: vocabulary, en: "Humidity",     zh: "湿度" }
copy wind       { class: vocabulary, en: "Wind",         zh: "风速" }
copy pressure   { class: vocabulary, en: "Pressure",     zh: "气压" }
copy uv         { class: vocabulary, en: "UV Index",     zh: "紫外线" }
copy precip     { class: vocabulary, en: "Rain",         zh: "降水概率" }
copy visibility { class: vocabulary, en: "Visibility",   zh: "能见度" }
copy sky   { class: vocabulary, en: "Satellite", zh: "卫星云图" }
copy air        { class: vocabulary, en: "Air Quality",  zh: "空气质量" }
copy sunrise    { class: vocabulary, en: "Sunrise",      zh: "日出" }
copy sunset     { class: vocabulary, en: "Sunset",       zh: "日落" }

# ── view ─────────────────────────────────────────────────────────────────────
view root  Photo(src: scene, pad: .page) {
             current
             forecast
             cloudfield
             airfield
             sunmoon
             details
           }

view current  Col(align: .center) {
                TextTitle(text: place.name)
                WeatherIcon(cond: now.cond, size: .hero)
                TextHero(value: now.temp, unit: units, on_tap: toggle_units)
                # `width: .fit` so the centred column can centre it. A row fills
                # by default, and a filling child ignores its parent's alignment.
                Row(gap: 8, width: .fit) {
                  TextCaption(glyph: "↑", value: now.hi, unit: units)
                  TextCaption(glyph: "↓", value: now.lo, unit: units)
                  TextCaption(glyph: "≈", value: now.feels, unit: units)
                }
              }

# Exercises the other half of the component contracts:
#   - LOCAL state and a local event (§5.7) — seven rows, seven `expanded` cells,
#     keyed by (declaration path, loop key), none of them in the ledger
#   - reads card-scope `source` directly (week.min_lo) — permitted by §5.3
#   - takes `unit` as a PROP, because card state may not be read directly;
#     that keeps the dependency visible to the tracker
#   - the transition is `toggle`, a total form, not `!expanded` (§3)
#
# Prop named `item`, not `day`: `width: .day` is a layout token. See finding #9.
component ForecastRow(item: record, unit: enum[c, f]) {
  state expanded { shape: bool, initial: false }
  event toggle   { expanded: toggle }
  view Col {
         Row(align: .center, on_tap: toggle) {
           TextRow(text: item.dayname, width: .day)
           WeatherIcon(cond: item.cond, size: .row)
           TextValue(value: item.lo, unit: unit)
           TempBar(lo: item.lo, hi: item.hi, min: week.min_lo, max: week.max_hi)
           TextValue(value: item.hi, unit: unit)
         }
         when expanded {
           Row(gap: 8) {
             TextCaption(text: item.cond)
           }
         }
       }
}

view forecast  Panel {
                 for d in week.days key d.dayname {
                   ForecastRow(item: d, unit: units)
                 }
               }

# The two map panes the shipping card has, in its order: the sky first, then the
# air. Both name a LOCATION and fetch their own image — a card that carried
# either would be carrying an observation (§4).
view cloudfield Panel {
                 TextCaption(text: copy.sky)
                 Satellite(lat: place.lat, lon: place.lon)
               }

view airfield  Panel {
                 TextCaption(text: copy.air)
                 AqiContour(lat: place.lat, lon: place.lon, span: 1.6)
               }

view sunmoon  Panel {
                Row {
                  Col { TextCaption(text: copy.sunrise) TextStat(value: sun.rise, format: .time) }
                  SunArc(rise: sun.rise, set: sun.set, now: sun.now)
                  Col { TextCaption(text: copy.sunset)  TextStat(value: sun.set,  format: .time) }
                }
                MoonPhase(phase: moon.phase, illum: moon.illumination)
              }

# The plan's `tiles: Vec<String>` becomes explicit structure. The model picks
# tiles by writing them, not by naming them in an array — more expressive, and
# it removes a loop over a model-authored list.
view details  Grid(cols: 2) {
                Tile(label: copy.feels,      value: now.feels,      unit: units)
                Tile(label: copy.humidity,   value: now.humidity,   unit: .pct)
                Tile(label: copy.wind,       value: now.wind,       unit: .speed)
                Tile(label: copy.pressure,   value: now.pressure,   unit: .pressure)
                Tile(label: copy.uv,         value: now.uv,         unit: .index)
                # `visibility` was here and renders an em dash: open-meteo serves
                # it hourly only, so no call answers it. `precip` is answered by
                # the same fetch and is the more useful sixth tile anyway.
                Tile(label: copy.precip,     value: now.precip,     unit: .pct)
              }
